{
  "name": "Healthcare Monitoring AI Agent Env",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "app.py"
      ]
    },
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user --upgrade pip && [ -f requirements.txt ] && pip3 install --user -r requirements.txt; echo '✅ All Agent dependencies and requirements successfully built!'",
  "postAttachCommand": {
    "server": "streamlit run app.py"
  },
  "portsAttributes": {
    "8501": {
      "label": "Healthcare Dashboard UI",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}
